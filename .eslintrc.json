{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:playwright/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "plugins": [
    "playwright"
  ],
  "ignorePatterns": [
    "node_modules/",
    "playwright-report/",
    "test-results/"
  ],
  "rules": {
    "no-unused-vars": "error",
    "no-console": [
      "warn",
      { "allow": ["warn", "error", "info", "debug"] }
    ],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "indent": ["error", 2, { "SwitchCase": 1 }],
    "comma-dangle": ["error", "always-multiline"],
    "eqeqeq": ["error", "always"],
    "object-shorthand": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.spec.js"],
      "rules": {
        // Page objects own the assertions about their own structure, so their
        // `expect*()` methods count as assertions. Add new ones here — the rule
        // only accepts literal names, not patterns.
        "playwright/expect-expect": [
          "error",
          {
            "assertFunctionNames": [
              "expect",
              "expectLoaded",
              "expectFormEditable",
              "expectFormRestricted",
              "expectPasswordRequirements"
            ]
          }
        ],
        // A permanently disabled test is a lint error; a run-time conditional
        // skip (an environment where the scenario does not exist) is allowed.
        "playwright/no-skipped-test": ["error", { "allowConditional": true }]
      }
    },
    {
      "files": ["src/pages/**/*.js", "src/fixtures/**/*.js"],
      "rules": {
        "playwright/no-standalone-expect": "off"
      }
    }
  ]
}
