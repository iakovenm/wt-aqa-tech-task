# Copy to .env and adjust as needed. Every value has a working default,
# so the suite runs with no .env at all.

# --- Application under test -------------------------------------------------
# Public marketing site.
MARKETING_BASE_URL=https://paydo.com
# Customer area hosting sign-up and log-in.
ACCOUNT_BASE_URL=https://account.paydo.com

# --- Users API --------------------------------------------------------------
# Leave empty to let Playwright start the bundled mock service (mock-api/).
# Set it to run the same specs against a deployed API, e.g. https://api.example.com
API_BASE_URL=
# Port the bundled mock service listens on.
MOCK_API_PORT=4017

# --- Application behaviour --------------------------------------------------
# PayDo does not offer personal accounts in every country. Leave empty to detect
# the region notice at run time (the affected scenario then skips itself), or set
# true/false to assert the expected state of the sign-up form.
PERSONAL_ACCOUNTS_AVAILABLE=

# --- Run tuning -------------------------------------------------------------
# Browser tests (ms).
# TEST_TIMEOUT=90000
# EXPECT_TIMEOUT=10000
# API tests (ms) — deliberately tighter, so a hung request fails fast.
# API_TEST_TIMEOUT=15000
# API_EXPECT_TIMEOUT=5000
# WORKERS=3
# RETRIES=2

# Set to true to print API request/response details.
DEBUG_LOGS=false
