{
  "name": "wt-aqa-tech-task",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + JavaScript automation framework for PayDo (UI + Users API)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "mock-api": "node mock-api/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "ajv": "^8.20.0",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-playwright": "^1.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
